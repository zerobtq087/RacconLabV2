# ===== Secretos =====
.env
**/.env

# ===== Se generan al ejecutar raccoon.sh (no se suben) =====
internal/web/dist/
internal/bin/
node_modules/
frontend/dist*/
opt/container-environment/*/*/web-server/volumes/internal/
opt/container-environment/container-images/raccoon/build/raccoon

# ===== Datos del servidor (viven en /opt, nunca en el repo) =====
opt/container-environment/*/*/web-server/volumes/logs/
opt/container-environment/*/*/db-engine/volumes/
opt/container-environment/*/*/gns3/volumes/gns3_projects/
opt/container-environment/*/*/gns3/volumes/gns3_images/
opt/container-environment/*/*/backup/volumes/

# ===== Editores =====
.vscode/
.idea/
*.log
