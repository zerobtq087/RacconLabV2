{# =====================================================================
   Configuración de un router Cisco (se carga como startup-config).
   "item" es el router del JSON ya resuelto por Go:
     item.interfaces[] → name, ip, netmask, vlan (subinterfaz dot1Q)
     item.parents[]    → interfaces físicas que hay que encender (subinterfaces)
     item.networks[]   → redes conectadas, para RIP/OSPF
   lab_design.project_settings → routing_protocol (rip | ospf) y ospf_area
   ===================================================================== #}
{% set ajustes = lab_design.project_settings %}
!
version 12.4
service timestamps debug datetime msec
service timestamps log datetime msec
no service password-encryption
!
hostname {{ item.name }}
!
banner motd $ RaccoonLAB - Emulador de Redes para Media Superior y Superior - UTTT $
no ip domain lookup
ip routing
!
{% for padre in item.parents | default([]) %}
interface {{ padre }}
 no ip address
 no shutdown
!
{% endfor %}
{% for iface in item.interfaces | default([]) %}
interface {{ iface.name }}
{% if iface.vlan | default(0) %}
 encapsulation dot1Q {{ iface.vlan }}
{% endif %}
{% if iface.ip | default('') %}
 ip address {{ iface.ip }} {{ iface.netmask }}
{% endif %}
 no shutdown
!
{% endfor %}
{% if ajustes.routing_protocol == 'ospf' %}
router ospf 1
 log-adjacency-changes
{% for red in item.networks | default([]) %}
 network {{ red.network }} {{ red.wildcard }} area {{ ajustes.ospf_area }}
{% endfor %}
!
{% elif ajustes.routing_protocol == 'rip' %}
router rip
 version 2
 no auto-summary
{% for red in item.networks | default([]) %}
 network {{ red.network }}
{% endfor %}
!
{% endif %}
line con 0
 exec-timeout 0 0
 logging synchronous
!
end
